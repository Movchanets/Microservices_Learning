{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identityRoute": {
        "ClusterId": "identityCluster",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        }
      },
      "catalogRoute": {
        "ClusterId": "catalogCluster",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        }
      },
      "orderingRoute": {
        "ClusterId": "orderingCluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "inventoryRoute": {
        "ClusterId": "inventoryCluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        }
      },
      "cartRoute": {
        "ClusterId": "cartCluster",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        }
      },
      "searchRoute": {
        "ClusterId": "searchCluster",
        "Match": {
          "Path": "/api/search/{**catch-all}"
        }
      },
      "storeRoute": {
        "ClusterId": "storeCluster",
        "Match": {
          "Path": "/api/stores/{**catch-all}"
        }
      },
      "mediaRoute": {
        "ClusterId": "mediaCluster",
        "Match": {
          "Path": "/api/media/{**catch-all}"
        }
      },
      "paymentRoute": {
        "ClusterId": "paymentCluster",
        "AuthorizationPolicy": "Authenticated",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "signalrRoute": {
        "ClusterId": "notificationCluster",
        "Match": {
          "Path": "/hubs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identityCluster": {
        "Destinations": {
          "identity": { "Address": "http://identity-api" }
        }
      },
      "catalogCluster": {
        "Destinations": {
          "catalog": { "Address": "http://catalog-api" }
        }
      },
      "orderingCluster": {
        "Destinations": {
          "ordering": { "Address": "http://ordering-api" }
        }
      },
      "inventoryCluster": {
        "Destinations": {
          "inventory": { "Address": "http://inventory-api" }
        }
      },
      "cartCluster": {
        "Destinations": {
          "cart": { "Address": "http://cart-api" }
        }
      },
      "searchCluster": {
        "Destinations": {
          "search": { "Address": "http://search-api" }
        }
      },
      "storeCluster": {
        "Destinations": {
          "store": { "Address": "http://store-api" }
        }
      },
      "mediaCluster": {
        "Destinations": {
          "media": { "Address": "http://media-api" }
        }
      },
      "paymentCluster": {
        "Destinations": {
          "payment": { "Address": "http://payment-api" }
        }
      },
      "notificationCluster": {
        "SessionAffinity": {
          "Enabled": true,
          "Policy": "HashCookie",
          "FailurePolicy": "Redistribute",
          "AffinityKeyName": "SignalR_Affinity"
        },
        "Destinations": {
          "notification": { "Address": "http://notification-api" }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200", "http://localhost:4201"]
  }
}

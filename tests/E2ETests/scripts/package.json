{
  "name": "rozetka-scraper",
  "version": "1.0.0",
  "description": "Rozetka product scraper for Marketplace Seeder.App",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape": "tsx rozetka-scraper.ts",
    "scrape:laptops": "tsx rozetka-scraper.ts --category laptops",
    "scrape:phones": "tsx rozetka-scraper.ts --category phones",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "playwright": "^1.43.0",
    "fs-extra": "^11.2.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/fs-extra": "^11.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0"
  }
}
